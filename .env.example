# Скопируйте в .env и заполните. Файл .env в git не попадает.

# dev — разработка; prod — завод (в prod тестовые учётки запрещены)
APP_ENV=dev
APP_VERSION=dev

# Пароль придумайте длинный (20+ символов). Только латиница и цифры, без @ : / —
# он подставляется в строку подключения.
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me-long-random-password
POSTGRES_DB=rag

HTTP_PORT=80
HTTPS_PORT=443

# Модели Ollama (лицензии: docs/licenses.md)
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
LLM_FALLBACK_MODEL=qwen3:4b
EMBEDDING_MODEL=bge-m3
LLM_NUM_CTX=8192
OLLAMA_VERSION=0.40.13

# Heartbeat потоковых ответов, секунд (не больше 3: Windows рвёт молчащие соединения)
SSE_HEARTBEAT_SECONDS=2

# Тестовые пользователи и фейковый источник (этап 1+). В prod — false.
ENABLE_TEST_USERS=true
# Фейковый внешний сервис (контейнер fake-service) запускается только в разработке.
# В prod удалите эту строку.
COMPOSE_PROFILES=dev

# ---------- Вход и сессии ----------
# Ключ подписи токенов. В prod обязателен (32+ символа); install.ps1 создаст его сам,
# если строка пустая. В разработке можно оставить пустым.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
# Сколько живёт сессия без повторного ввода пароля (часов)
REFRESH_TOKEN_HOURS=12
# Блокировка входа после N неудачных попыток на M минут
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Вход без пароля: поиск и общие документы
GUEST_MODE_ENABLED=true

# Проверка пароля во внешнем сервисе: POST {"login","password"} → {"ok": true/false}
AUTH_PROVIDER=external_check
# Разработка — фейковый сервис. На заводе — адрес функции проверки (только https://).
EXTERNAL_AUTH_URL=https://fake-service:8443/auth/check
# Сертификат CA внешнего сервиса (файл кладётся в папку certs/). В разработке — dev-сертификат.
EXTERNAL_AUTH_CA_FILE=/srv/certs/server.crt
# Если внешний сервис требует клиентский сертификат (mTLS):
# EXTERNAL_AUTH_CLIENT_CERT=/srv/certs/client.crt
# EXTERNAL_AUTH_CLIENT_KEY=/srv/certs/client.key

# ---------- Документы и синхронизация (этап 2) ----------
# Часовой пояс завода: в нём считается час ночной сверки.
APP_TIMEZONE=Europe/Moscow
# Сертификат CA источника документов. Пусто — тот же, что EXTERNAL_AUTH_CA_FILE.
# SOURCE_CA_FILE=/srv/certs/source-ca.crt
# Если источник требует клиентский сертификат (mTLS):
# SOURCE_CLIENT_CERT=/srv/certs/client.crt
# SOURCE_CLIENT_KEY=/srv/certs/client.key
SOURCE_TIMEOUT_SECONDS=30
# Файлы больше этого не скачиваем (МБ); ручная загрузка — до MANUAL_UPLOAD_MAX_MB.
SOURCE_FILE_MAX_MB=200
MANUAL_UPLOAD_MAX_MB=50
# Распознавание сканов (Tesseract)
OCR_LANGUAGES=rus+eng
OCR_DPI=300
# Попыток обработки документа до статуса «ошибка» и пауза между попытками (секунд)
DOCUMENT_MAX_ATTEMPTS=3
DOCUMENT_RETRY_DELAY_SECONDS=60
